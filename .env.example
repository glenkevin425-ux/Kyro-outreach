# Copy this file to .env and keep secrets out of source control.
# The SQLite database is stored locally in ./data/kyro.sqlite3 by default.
DATABASE_PATH=./data/kyro.sqlite3

# Public app URL and session-cookie settings. Set COOKIE_SECURE=true behind HTTPS.
APP_URL=http://localhost:8000
COOKIE_SECURE=false

# Demo workspace is intentionally enabled for local preview; demo sends are simulated only.
KYRO_DEMO_ENABLED=true

# Optional production email provider. Credentials stay server-side.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Reserved for a future server-side AI adapter; the current grounded template generator does not use it.
AI_API_KEY=

# Required to authorize POST /api/cron/run in a deployed environment.
CRON_SECRET=

# Optional bearer secret for the provider-neutral POST /api/webhooks/reply adapter endpoint.
REPLY_WEBHOOK_SECRET=
