# Local database
DATABASE_PATH=./data/kyro.sqlite3

# Optional PostgreSQL for deployed environments
DATABASE_URL=

# Demo workspace
KYRO_DEMO_ENABLED=true

# Deployment
COOKIE_SECURE=false
APP_URL=http://localhost:8000

# Live email provider (optional)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Trusted worker
CRON_SECRET=

# Reply event endpoint
REPLY_WEBHOOK_SECRET=